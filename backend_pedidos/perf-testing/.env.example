# Configuración del servicio backend-perf (cargada con env_file)
# Copiá este archivo a .env y completá los valores. NO commitees .env.

# Servidor
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3001

# Base de datos (host = nombre de servicio del compose)
DB_HOST=postgres-perf
DB_PORT=5432
DB_USERNAME=perf_user
DB_PASSWORD=perf_pass
DB_NAME=pedilo_perf_test

# JWT (generá un secreto aleatorio)
JWT_SECRET=

# Cloudinary (opcional si el test no sube imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=